#!/bin/bash
# Script to replace keystore files in WSO2 API Manager pack
# Usage: apim-replace-keystores <path-to-wso2am-zip>

set -e

SCRIPT_NAME="$(basename "$0")"
SOURCE_TRUSTSTORE="/home/randikam/projects/product-apim/all-in-one-apim/modules/integration-v2/client-truststore.jks"
SOURCE_CARBON="/home/randikam/projects/product-apim/all-in-one-apim/modules/integration-v2/wso2carbon.jks"

# Function to print usage
usage() {
    echo "Usage: $SCRIPT_NAME <path-to-wso2am-zip>"
    echo ""
    echo "Replace client-truststore.jks and wso2carbon.jks in the APIM pack"
    echo "with the keystores from all-in-one-apim/modules/integration-v2"
    echo ""
    echo "Example:"
    echo "  $SCRIPT_NAME /path/to/wso2am-4.7.0.zip"
}

# Check if zip file is provided
if [ $# -eq 0 ]; then
    echo "Error: No zip file specified."
    usage
    exit 1
fi

APIM_ZIP="$1"

# Verify source files exist
if [ ! -f "$SOURCE_TRUSTSTORE" ]; then
    echo "Error: Source truststore not found: $SOURCE_TRUSTSTORE"
    exit 1
fi

if [ ! -f "$SOURCE_CARBON" ]; then
    echo "Error: Source carbon keystore not found: $SOURCE_CARBON"
    exit 1
fi

# Verify zip file exists
if [ ! -f "$APIM_ZIP" ]; then
    echo "Error: APIM zip not found: $APIM_ZIP"
    exit 1
fi

# Get the product name from zip (e.g., wso2am-4.7.0)
PRODUCT_NAME=$(unzip -l "$APIM_ZIP" | head -5 | tail -1 | awk '{print $NF}' | cut -d'/' -f1)

if [ -z "$PRODUCT_NAME" ]; then
    echo "Error: Could not determine product name from zip"
    exit 1
fi

SECURITY_PATH="${PRODUCT_NAME}/repository/resources/security/"

echo "Product: $PRODUCT_NAME"
echo "Target path in zip: $SECURITY_PATH"
echo ""

# Check if files exist in zip
if ! unzip -l "$APIM_ZIP" "${SECURITY_PATH}client-truststore.jks" > /dev/null 2>&1; then
    echo "Warning: client-truststore.jks not found in expected path in zip"
fi

if ! unzip -l "$APIM_ZIP" "${SECURITY_PATH}wso2carbon.jks" > /dev/null 2>&1; then
    echo "Warning: wso2carbon.jks not found in expected path in zip"
fi

# Create temp directory
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

echo "Replacing keystore files..."

# Create the directory structure
mkdir -p "$TEMP_DIR/$SECURITY_PATH"

# Copy new keystores to temp location
cp "$SOURCE_TRUSTSTORE" "$TEMP_DIR/${SECURITY_PATH}client-truststore.jks"
cp "$SOURCE_CARBON" "$TEMP_DIR/${SECURITY_PATH}wso2carbon.jks"

# Update the zip file (delete old entries first, then add new ones)
zip -d "$APIM_ZIP" "${SECURITY_PATH}client-truststore.jks" 2>/dev/null || true
zip -d "$APIM_ZIP" "${SECURITY_PATH}wso2carbon.jks" 2>/dev/null || true

# Add new keystores
cd "$TEMP_DIR"
zip -u "$APIM_ZIP" "${SECURITY_PATH}client-truststore.jks" "${SECURITY_PATH}wso2carbon.jks"

echo ""
echo "✓ Keystore files replaced successfully!"
echo ""
echo "Updated files in: $APIM_ZIP"
echo "  - ${SECURITY_PATH}client-truststore.jks"
echo "  - ${SECURITY_PATH}wso2carbon.jks"
